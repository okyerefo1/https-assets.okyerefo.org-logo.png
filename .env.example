# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored. Never commit real passwords.
# Generate each one with:  openssl rand -base64 32

# --- MariaDB (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# --- PostgreSQL (docker-compose.postgres.yml) ---
POSTGRES_PASSWORD=
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud

# --- Nextcloud admin account, created on first install ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Space-separated. Add every hostname you will reach Nextcloud on, or
# it answers with "Access through untrusted domain".
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Outbound proxy (leave empty unless your host needs one) ---
# Deliberately NOT named HTTP_PROXY/HTTPS_PROXY: compose lets the shell
# environment override .env, so a proxy exported on the host - often one
# on 127.0.0.1, unreachable from a container - would silently win.
#
# These only cover shell tools inside the container. Nextcloud's own PHP
# requests read the proxy from config.php - set that one with:
#   PROXY=proxy.example.com:3128 ./scripts/fix-internet-connection.sh
NEXTCLOUD_HTTP_PROXY=
NEXTCLOUD_HTTPS_PROXY=
NEXTCLOUD_NO_PROXY=localhost,127.0.0.1,db,redis

# --- Host / PHP tuning ---
HTTP_PORT=8080
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G
