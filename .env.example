# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored. Never commit real passwords.
# Generate each one with:  openssl rand -base64 32

# --- MariaDB (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# --- PostgreSQL (docker-compose.postgres.yml) ---
POSTGRES_PASSWORD=
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud

# --- Nextcloud admin account, created on first install ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Space-separated. Add every hostname you will reach Nextcloud on, or
# it answers with "Access through untrusted domain".
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Host / PHP tuning ---
HTTP_PORT=8080
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G
